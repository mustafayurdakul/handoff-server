# Copy to .env and adjust. Relative paths are relative to the folder handoff is started from.

# Folder that handoff watches for new tickets (.md files)
HANDOFF_INBOX=./inbox
# Ticket state, live feeds and working copies, one folder per ticket
HANDOFF_RUNS=./runs
# Git repositories the agents work on: one folder per [projects.<name>] in the config
HANDOFF_PROJECTS=./projects
HANDOFF_CONFIG=./config.toml

# API address. It has no login, so keep it on this machine.
HANDOFF_HOST=127.0.0.1
HANDOFF_PORT=8765

# Only needed when Jira or GitLab is enabled in the config
# JIRA_TOKEN=
# GITLAB_TOKEN=
